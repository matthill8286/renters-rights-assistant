# Leave the Reapit values empty to run on the demo data in fixtures/.
# Sandbox: create an app in the Reapit Developer Portal with the client
# credentials flow and set REAPIT_CUSTOMER_ID=SBOX.
REAPIT_CLIENT_ID=
REAPIT_CLIENT_SECRET=
REAPIT_CUSTOMER_ID=SBOX
AGENCY_NAME=Your agency

# Pin "today" for demos and tests (YYYY-MM-DD). Leave unset in real use.
RRA_TODAY=

# HTTP mode only (npm run start:http)
PORT=3333
HOST=127.0.0.1
# Required if HOST is not localhost.
MCP_AUTH_TOKEN=
